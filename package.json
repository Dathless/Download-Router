    "test:e2e": "node scripts/phase0-e2e.mjs"
  },
  "dependencies": {
    "re2js": "2.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/chrome": "0.3.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
